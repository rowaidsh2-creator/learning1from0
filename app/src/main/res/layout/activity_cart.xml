<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cartLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".CartActivity">

    <!-- عنوان شاشة السلة -->
    <TextView
        android:id="@+id/textCartTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="سلة المشتريات 🛒"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="16dp" />

    <!-- قائمة عطور السلة -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewCart"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/btnBackFromCart"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textCartTitle"
        tools:listitem="@layout/item_perfume" />

    <!-- نص السلة فارغة -->
    <TextView
        android:id="@+id/textEmptyCart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="سلتك فارغة حالياً! اضف بعض العطور 🌸"
        android:textSize="16sp"
        android:textColor="@android:color/darker_gray"
        app:layout_constraintBottom_toTopOf="@id/btnBackFromCart"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textCartTitle" />

    <!-- زر العودة -->
    <Button
        android:id="@+id/btnBackFromCart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="الرجوع ⬅️"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
