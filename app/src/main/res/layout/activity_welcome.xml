<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/welcomeLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    tools:context=".WelcomeActivity">

    <!-- عنوان الترحيب الرئيسي -->
    <TextView
        android:id="@+id/textWelcomeTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="مرحباً بك في Aura 🌸"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        app:layout_constraintBottom_toTopOf="@id/textWelcomeSubtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <!-- وصف فرعي جميل -->
    <TextView
        android:id="@+id/textWelcomeSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="اكتشف أفخم العطور والماركات العالمية"
        android:textSize="16sp"
        android:textColor="@android:color/darker_gray"
        android:layout_marginTop="12dp"
        app:layout_constraintBottom_toTopOf="@id/btnEnterStore"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textWelcomeTitle" />

    <!-- زر الدخول إلى الشاشة الثانية (المتجر) -->
    <Button
        android:id="@+id/btnEnterStore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="دخول المتجر ➔"
        android:textSize="18sp"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_marginTop="36dp"
        app:layout_constraintBottom_toTopOf="@id/btncartenter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textWelcomeSubtitle" />

    <!-- زر السلة (btncartenter) -->
    <Button
        android:id="@+id/btncartenter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="سلة المشتريات 🛒"
        android:textSize="16sp"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnEnterStore" />

</androidx.constraintlayout.widget.ConstraintLayout>
